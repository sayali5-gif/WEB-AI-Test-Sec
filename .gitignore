# ==========================================
# AI-WebSecTest - Git Ignore
# ==========================================

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.development

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ---------- FastAPI / Backend ----------
*.log
logs/
*.sqlite
*.sqlite3

# Local runtime files
backend/uploads/
backend/tmp/
backend/temp/

# ---------- PostgreSQL / Database ----------
*.dump
*.backup
*.bak

# Keep SQL schema/migrations tracked
# database/migrations/*.sql

# Ignore local database exports if desired
# database/backups/

# ---------- Node / React ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.next/
out/

# React/Vite
.vite/
vite.config.*.timestamp-*

# ---------- Testing ----------
coverage/
.nyc_output/
playwright-report/
test-results/

# ---------- IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# ---------- Operating System ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Temporary files ----------
*.tmp
*.temp
*.swp
*.swo
*~
*.bak

# ---------- Uploaded / generated files ----------
uploads/
generated/
artifacts/

# ---------- Security scanner output ----------
scan-results/
reports/
screenshots/
pcaps/

# Do not accidentally commit secrets
*.pem
*.key
*.crt
*.p12
*.pfx

# ---------- Personal / local files ----------
notes.local.*
local.*
*.local

# ---------- Editor ----------
.history/

# ---------- Claude / AI tooling ----------
.claude/
.cursor/
.copilot/

# ---------- OS-specific ----------
ehthumbs.db
